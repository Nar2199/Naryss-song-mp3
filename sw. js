const CACHE_NAME = 'naryss-songs-v2';

// 1. تثبيت التطبيق وتخزين الملفات الأساسية
self.addEventListener('install', (e) => {
    e.waitUntil(
        caches.open(CACHE_NAME).then((cache) => {
            return cache.addAll([
                './',
                './index.html'
            ]);
        })
    );
    self.skipWaiting();
});

// 2. تفعيل الخدمة وتنظيف الذاكرة القديمة
self.addEventListener('activate', (e) => {
    e.waitUntil(
        caches.keys().then((cacheNames) => {
            return Promise.all(
                cacheNames.map((cache) => {
                    if (cache !== CACHE_NAME) {
                        return caches.delete(cache);
                    }
                })
            );
        }).then(() => self.clients.claim())
    );
});

// 3. جلب الأغاني والملفات (Offline Mode & Cache)
self.addEventListener('fetch', (e) => {
    e.respondWith(
        caches.match(e.request).then((cachedResponse) => {
            return cachedResponse || fetch(e.request).then((response) => {
                return caches.open(CACHE_NAME).then((cache) => {
                    cache.put(e.request, response.clone());
                    return response;
                });
            }).catch(() => {
                return caches.match('./index.html');
            });
        })
    );
});

// 4. استجابة الإشعارات (Push Notifications Logic)
self.addEventListener('push', (e) => {
    const data = e.data ? e.data.json() : {};
    const title = data.title || 'Naryss Music';
    const options = {
        body: data.body || 'New music update is available!',
        icon: './icon-512x512.png',
        badge: './icon-512x512.png'
    };
    e.waitUntil(self.registration.showNotification(title, options));
});

// 5. استجابة مزامنة الخلفية (Background Sync Logic)
self.addEventListener('sync', (e) => {
    if (e.tag === 'naryss-sync') {
        e.waitUntil(
            // منطق مزامنة البيانات في الخلفية عند عودة الإنترنت
            Promise.resolve()
        );
    }
});

// 6. استجابة المزامنة الدورية (Periodic Sync Logic)
self.addEventListener('periodicsync', (e) => {
    if (e.tag === 'naryss-periodic-sync') {
        e.waitUntil(
            // منطق تحديث المحتوى دورياً في الخلفية
            Promise.resolve()
        );
    }
});
