const CACHE_NAME = 'naryss-songs-v1';

// تثبيت التطبيق وتخزين الصفحة الأساسية في الذاكرة
self.addEventListener('install', (e) => {
    e.waitUntil(
        caches.open(CACHE_NAME).then((cache) => {
            return cache.addAll([
                './',
                './index.html'
            ]);
        })
    );
    self.skipWaiting();
});

// تفعيل الخدمة وتنظيف الكاش القديم عند الحاجة
self.addEventListener('activate', (e) => {
    e.waitUntil(self.clients.claim());
});

// تشغيل التطبيق والأغاني حتى لو انقطع الإنترنت (Offline Mode)
self.addEventListener('fetch', (e) => {
    e.respondWith(
        caches.match(e.request).then((cachedResponse) => {
            return cachedResponse || fetch(e.request).then((response) => {
                // تخزين أي أغنية أو صورة يتم تشغيلها تلقائياً في ذاكرة الهاتف للاستخدام لاحقاً بدون إنترنت
                return caches.open(CACHE_NAME).then((cache) => {
                    cache.put(e.request, response.clone());
                    return response;
                });
            }).catch(() => {
                // في حال انقطاع الإنترنت نهائياً، يتم جلب الملف من ذاكرة الهاتف المؤقتة
                return caches.match(e.request);
            });
        })
    );
});

// 1. تفعيل استقبال الإشعارات (Push Notifications)
self.addEventListener('push', (e) => {
    const data = e.data ? e.data.json() : { title: 'Naryss Music', body: 'New track is available!' };
    const options = {
        body: data.body,
        icon: './icon-512x512.png',
        badge: './icon-512x512.png'
    };
    e.waitUntil(
        self.registration.showNotification(data.title, options)
    );
});

// 2. تفعيل المزامنة في الخلفية (Background Sync)
self.addEventListener('sync', (e) => {
    if (e.tag === 'sync-songs') {
        console.log('Background syncing songs...');
        // يمكنك وضع أي مهام مزامنة هنا مستقبلاً
    }
});

// 3. تفعيل المزامنة الدورية (Periodic Sync - إن توفر دعم المتصفح)
self.addEventListener('periodicsync', (e) => {
    if (e.tag === 'update-content') {
        e.waitUntil(
            // تحديث البيانات في الخلفية دورياً
            console.log('Periodic background sync running...')
        );
    }
});
