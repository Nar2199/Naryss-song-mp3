const CACHE_NAME = 'naryss-songs-v1';

// 1. تثبيت التطبيق وتخزين الملفات
self.addEventListener('install', (event) => {
    event.waitUntil(
        caches.open(CACHE_NAME).then((cache) => {
            return cache.addAll([
                './',
                './index.html'
            ]);
        })
    );
    self.skipWaiting();
});

// 2. تفعيل الخدمة
self.addEventListener('activate', (event) => {
    event.waitUntil(self.clients.claim());
});

// 3. المنطق الأساسي للـ Fetch (هذا هو المسؤول عن إضاءة Has Logic و Offline Support)
self.addEventListener('fetch', (event) => {
    event.respondWith(
        caches.match(event.request).then((response) => {
            return response || fetch(event.request).then((fetchResponse) => {
                return caches.open(CACHE_NAME).then((cache) => {
                    cache.put(event.request, fetchResponse.clone());
                    return fetchResponse;
                });
            }).catch(() => {
                return caches.match('./index.html');
            });
        })
    );
});

// 4. معالج الإشعارات (Push Notifications)
self.addEventListener('push', (event) => {
    const title = 'Naryss Music';
    const options = {
        body: event.data ? event.data.text() : 'New track available!',
        icon: './icon-512x512.png'
    };
    event.waitUntil(self.registration.showNotification(title, options));
});

// 5. معالج المزامنة في الخلفية (Background Sync)
self.addEventListener('sync', (event) => {
    if (event.tag === 'sync-track') {
        event.waitUntil(Promise.resolve());
    }
});

// 6. معالج المزامنة الدورية (Periodic Sync)
self.addEventListener('periodicsync', (event) => {
    if (event.tag === 'content-sync') {
        event.waitUntil(Promise.resolve());
    }
});
