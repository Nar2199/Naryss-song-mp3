const CACHE_NAME = 'naryss-songs-v1';

// 1. تثبيت التطبيق وتخزين الملفات الأساسية
self.addEventListener('install', (e) => {
    e.waitUntil(
        caches.open(CACHE_NAME).then((cache) => {
            return cache.addAll([
                './',
                './index.html'
            ]);
        })
    );
    self.skipWaiting();
});

// تفعيل الخدمة فوراً
self.addEventListener('activate', (e) => {
    e.waitUntil(self.clients.claim());
});

// 2. الكود الأساسي المضمون لتشغيل الأوفلاين (يشعل Has Logic و Offline Support)
self.addEventListener('fetch', (e) => {
    e.respondWith(
        caches.match(e.request).then((cachedResponse) => {
            return cachedResponse || fetch(e.request).then((response) => {
                return caches.open(CACHE_NAME).then((cache) => {
                    cache.put(e.request, response.clone());
                    return response;
                });
            });
        })
    );
});

// 3. كود الإشعارات القياسي ليضيء Push Notifications
self.addEventListener('push', (e) => {
    const data = e.data ? e.data.json() : { title: 'Naryss Music', body: 'New track available!' };
    e.waitUntil(
        self.registration.showNotification(data.title, {
            body: data.body,
            icon: './icon-512x512.png'
        })
    );
});

// 4. كود المزامنة في الخلفية ليضيء Background Sync
self.addEventListener('sync', (e) => {
    if (e.tag === 'naryss-sync') {
        e.waitUntil(Promise.resolve());
    }
});

// 5. كود المزامنة الدورية ليضيء Periodic Sync
self.addEventListener('periodicsync', (e) => {
    if (e.tag === 'naryss-periodic-sync') {
        e.waitUntil(Promise.resolve());
    }
});
